<?xml version="1.0" encoding="utf-8"?>
<!-- Small notification icon (status bar): the Fandom Verse mark (F, V,
     orbit ring and moon) as a white silhouette on transparent. Android
     tints small icons to one colour, so it must not contain colour. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- F -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M3.6,5.6h6.6v2.3H6.1v2.6h3.6v2.2H6.1v4.9H3.6z" />
    <!-- V -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M10.9,5.6h2.6l2.3,7.7l2.3,-7.7h2.6l-3.6,11.1h-2.6z" />
    <!-- Orbit ring -->
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="-14">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="1.1"
            android:pathData="M1.4,12a10.6,3.4 0,1 0,21.2 0a10.6,3.4 0,1 0,-21.2 0z" />
    </group>
    <!-- Moon -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M10.9,16.3m-1.6,0a1.6,1.6 0,1 1,3.2 0a1.6,1.6 0,1 1,-3.2 0" />
</vector>
