rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Server-side admin check — reads the caller's own Firestore document.
    // This is the real enforcement layer; client-side route guards are UI only.
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Users collection ─────────────────────────────────────────────────────

    match /users/{uid} {
      // A user can read their own document; admins can read any.
      allow read: if isOwner(uid) || isAdmin();

      // New documents created by the owner must have role == 'fan'.
      // Admins are only ever created manually via the Firebase console —
      // the app itself can never self-grant an admin role.
      allow create: if isOwner(uid) && request.resource.data.role == 'fan';

      // Owners can update any field EXCEPT role (prevents self-promotion).
      // Admins can update any field including role (for granting/revoking admin).
      allow update: if isAdmin() ||
                       (isOwner(uid) && request.resource.data.role == resource.data.role);

      allow delete: if isAdmin();
    }

    // ── Content collections (read-public, write-admin) ────────────────────────

    match /fandoms/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /glossary/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Admin-managed content (read-public, write-admin) ──────────────────────

    match /posts/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /merchandise/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Read by the pre-login intro carousel, so it must be public.
    match /onboarding_slides/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Shop: carts & orders ──────────────────────────────────────────────────

    // Each user's cart lines live under their own user doc; nobody else's.
    match /users/{uid}/cart/{productId} {
      allow read, delete: if isSignedIn() && isOwner(uid);
      allow create, update: if isSignedIn() && isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['productId', 'name', 'price', 'imageUrl', 'quantity'])
        && request.resource.data.productId == productId
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.price is number;
    }

    // Users read only their own orders; admins read all. Users may only
    // create a fresh 'Placed' order for themselves; only admins change status.
    match /orders/{orderId} {
      allow read: if isAdmin() ||
                     (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(
             ['orderId', 'userId', 'items', 'subtotal', 'total', 'status', 'createdAt'])
        && request.resource.data.orderId == orderId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'Placed'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal >= 0
        && request.resource.data.total == request.resource.data.subtotal
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['Placed', 'Processing', 'Completed'];
      allow delete: if false;
    }

    // ── Catch-all ─────────────────────────────────────────────────────────────
    // Admin-only, top-level documents only, and never `orders`. Rules are
    // OR'd across every matching block, so anything broader here would
    // override the narrower rules above (e.g. let any signed-in user read
    // other users' profiles/orders, or let admins rewrite order totals).

    match /{collectionId}/{docId} {
      allow read, write: if isAdmin() && collectionId != 'orders';
    }
  }
}
